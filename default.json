{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",
  "extends": [
    "config:recommended",
    ":maintainLockFilesWeekly",
    "schedule:automergeDaily",
    "schedule:daily",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":enablePreCommit",
    "abandonments:recommended",
    ":configMigration"
  ],
  "prConcurrentLimit": 5,
  "prBodyNotes": ["Instructions-PR: none"],
  "osvVulnerabilityAlerts": true,
  "configMigration": true,
  "autodiscover": true,
  "automergeType": "pr",
  "major": { "automerge": false },
  "automerge": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)([Dd]ocker|[Cc]ontainer)file$/",
        "/(^|/)([Dd]ocker|[Cc]ontainer)file[^/]*$/",
        "/(^|/)container/([Dd]ocker|[Cc]ontainer)file[^/]*$/",
        "/\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+)(?:.*?depName=(?<depName>\\S+))?(?:.*?registryUrl=(?<registryUrl>\\S+))?(?:.*?extractVersion=(?<extractVersion>\\S+))?(?:.*?versioning=(?<versioning>\\S+))?\\s.*?(ARG\\s+)?\\w*_?VERSION[=:]\\s*version_(?<currentValue>\\d+)\\s",
        "# renovate: datasource=(?<datasource>\\S+)(?:.*?depName=(?<depName>\\S+))?(?:.*?registryUrl=(?<registryUrl>\\S+))?(?:.*?extractVersion=(?<extractVersion>\\S+))?(?:.*?versioning=(?<versioning>\\S+))?\\s.*?(ARG\\s+)?\\w*_?VERSION[=:]\\s*(?<currentValue>\\S+)\\s"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Matches shell scripts with vendored dependency versions",
      "managerFilePatterns": ["/\\.sh$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*depName=(?<depName>[^\\s]+)\\s+datasource=(?<datasource>[^\\s]+)\\s*\\nexport\\s+\\w+_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "semver"
    }
  ],
  "labels": ["dependency 📦️"],
  "packageRules": [
    { "matchManagers": ["cargo", "npm", "dockerfile"] },
    {
      "groupName": "cargo deps non-major",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "pre-commit non-major",
      "matchManagers": ["pre-commit"],
      "matchUpdateTypes": ["minor", "patch"],
      "addLabels": ["build"]
    },
    {
      "groupName": "node deps non-major",
      "matchManagers": ["bun", "npm"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Update vendored dependencies monthly",
      "matchFileNames": [
        "**/*.sh",
        "**/Dockerfile*",
        "**/Containerfile*",
        "**/*.env"
      ],
      "schedule": ["on the first day of the month"]
    },
    {
      "description": "Group crow and docker-compose manager updates",
      "matchManagers": ["crow", "docker-compose"],
      "groupName": "crow and docker-compose",
      "schedule": ["every monday"]
    },
    {
      "description": "Bump the declared range on every in-range update instead of only refreshing the lockfile. Otherwise direct dependencies (prettier, eslint, vue-tsc, ...) only move during lock file maintenance, where a formatter or linter release changes CI output inside an unrelated bulk PR that then fails. With bump, lock file maintenance only refreshes transitive dependencies.",
      "matchManagers": ["npm", "bun", "pep621"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Move the prettier package and its pre-commit mirror in one PR, so the hook that formats locally and the copy CI checks with never run different versions. Keep this after any node deps group so it wins.",
      "groupName": "prettier",
      "matchPackageNames": [
        "prettier",
        "rbubley/mirrors-prettier",
        "pre-commit/mirrors-prettier"
      ]
    }
  ]
}
